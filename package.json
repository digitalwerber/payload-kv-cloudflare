{
  "name": "@digitalwerber/payload-kv-cloudflare",
  "version": "0.1.0",
  "description": "Payload KV adapter for Cloudflare Workers KV",
  "keywords": [
    "payload",
    "payload-plugin",
    "payload-kv",
    "cloudflare",
    "workers-kv"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalwerber/payload-kv-cloudflare.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint",
    "lint:fix": "eslint ./src --fix",
    "test": "pnpm test:int && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:int": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260730.1",
    "@eslint/eslintrc": "^3.2.0",
    "@payloadcms/db-mongodb": "4.0.0-beta.7",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "4.0.0-beta.7",
    "@payloadcms/richtext-lexical": "4.0.0-beta.7",
    "@payloadcms/ui": "4.0.0-beta.7",
    "@playwright/test": "1.63.0",
    "@swc-node/register": "1.10.9",
    "@swc/cli": "0.6.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.4.2",
    "graphql": "^16.8.1",
    "miniflare": "4.20260730.0",
    "mongodb-memory-server": "10.1.4",
    "next": "16.4.2",
    "open": "^10.1.0",
    "oxfmt": "^0.73.0",
    "payload": "4.0.0-beta.7",
    "qs-esm": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "3.0.2",
    "sort-package-json": "^2.10.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "payload": "^3.62.0 || ^4.0.0-beta.7"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "registry": "https://registry.npmjs.org/"
}
